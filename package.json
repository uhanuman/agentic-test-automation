{
  "name": "agentic-test-automation",
  "version": "1.0.0",
  "description": "Decoupled Enterprise Test Automation Framework & Executable Test Scripts generated by Agentic Workflow",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test tests/*.api.spec.ts",
    "test:ui": "playwright test tests/*.ui.spec.ts",
    "test:a11y": "playwright test tests/*.a11y.spec.ts",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "test-automation",
    "agentic-qe",
    "api-testing",
    "ui-testing",
    "accessibility"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.1",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.3"
  }
}
